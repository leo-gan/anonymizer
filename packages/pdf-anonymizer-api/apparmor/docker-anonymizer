# Optional AppArmor profile for the official image.
# Not enabled by default. Load it, then point compose at the name.
#
#   sudo apparmor_parser -r -W packages/pdf-anonymizer-api/apparmor/docker-anonymizer
#   # in docker-compose.yml, under the service:
#   #   security_opt:
#   #     - apparmor:docker-anonymizer
#
# This is a starting point for untrusted PDFs on a Linux host.
# It is not a complete sandbox and not a legal control.

#include <tunables/global>

profile docker-anonymizer flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  #include <abstractions/python>

  network inet tcp,
  network inet udp,
  network inet6 tcp,
  network inet6 udp,

  /usr/local/bin/python* ix,
  /usr/local/lib/python*/** r,
  /usr/local/bin/pdf-anonymizer-api rix,
  /src/** r,
  /work/** rw,
  /tmp/** rw,
  /dev/urandom r,
  /proc/sys/kernel/random/uuid r,
}
